<?xml version="1.0"?>
<package format="3">
  <name>wra_driver</name>
  <version>0.1.0</version>
  <description>WRA-1 wheelchair robotic arm: ESP32 supervisor link, kinematics (ABENICS wrist), door-knob task, voice commands.</description>
  <maintainer email="noreply@example.com">landen-finkel-engineering</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>wra_description</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
